# Supabase — public (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase — server-only (NEVER use NEXT_PUBLIC_ prefix here)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# AI / Interview Engine (PROJ-2)
# Anthropic API key for the interview agent
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Model ID passed to the Anthropic provider (e.g. claude-opus-4-5, claude-sonnet-4-6)
INTERVIEW_MODEL=claude-opus-4-5
