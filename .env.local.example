# Supabase — public (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase — server-only (NEVER use NEXT_PUBLIC_ prefix here)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# AI / Interview Engine
# Format: "provider/model-id"
# Supported providers: anthropic, google
INTERVIEW_MODEL=google/gemini-3.5-flash

# Required if INTERVIEW_MODEL starts with "anthropic/"
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required if INTERVIEW_MODEL starts with "google/"
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# OpenAI — Embeddings (knowledge object extraction + vector search)
OPENAI_API_KEY=your_openai_api_key_here
