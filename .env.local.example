# Supabase — public (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase — server-only (NEVER use NEXT_PUBLIC_ prefix here)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# AI — Model Selection
# Format: "provider/model-id" — supported providers: anthropic, google
# All three vars fall back to google/gemini-3.1-flash-lite if unset.
INTERVIEW_MODEL=google/gemini-3.1-flash-lite
EXTRACTION_MODEL=google/gemini-3.1-flash-lite
ENRICHMENT_MODEL=google/gemini-3.1-flash-lite

# Required if any MODEL var starts with "anthropic/"
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required if any MODEL var starts with "google/"
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# Jina AI — Embeddings (knowledge object extraction + vector search)
# Get a free API key at https://jina.ai (1M free tokens on signup)
JINA_API_KEY=your_jina_api_key_here

# Embedding model (default: jina-embeddings-v3, 1024 dimensions)
# DSGVO fallback: set to a HuggingFace Inference Endpoint model ID
EMBEDDING_MODEL=jina-embeddings-v3

# Access Control (PROJ-10) — invite-only signup allowlist
# Comma-separated lowercase emails. Leave empty to disable allowlist (NOT recommended in prod).
ALLOWED_EMAILS=lias.hemmersbach@gmail.com,bennewroly@gmail.com

# Rate Limiting (PROJ-11) — Upstash Redis (server-only, NEVER use NEXT_PUBLIC_ prefix)
# Create a free database at https://console.upstash.com
# Leave unset in local dev to skip rate limiting (fail-open).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Voice Input (PROJ-7) — ElevenLabs Scribe v2 Realtime (server-only, NEVER use NEXT_PUBLIC_ prefix)
# Create an account at https://elevenlabs.io and copy your API key.
# Leave unset to disable the voice input button entirely.
ELEVENLABS_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Process Clustering (PROJ-18) — Cosine similarity threshold for semantic deduplication
# Steps with similarity >= threshold are grouped into the same cluster (default: 0.85)
# CLUSTER_SIMILARITY_THRESHOLD=0.85

# Eval Harness (PROJ-8) — nur lokal, NIEMALS Produktionswerte hier eintragen
# Vorher ein Test-Interview in der lokalen DB anlegen, IDs dort ablesen.
# TEST_INTERVIEW_TOKEN=<uuid aus der access_token-Spalte>
# TEST_INTERVIEW_ID=<id des Interview-Datensatzes>
# TEST_WORKSPACE_ID=<id des Test-Workspace>
# EVAL_BASE_URL=http://localhost:3000

# LLM Observability — Langfuse (PROJ-13)
# Create a free account at https://cloud.langfuse.com (EU region)
# LANGFUSE_ENABLED defaults to false — set to true only for eval runs or when you want prod tracing.
# Hot-Reload-Spam from npm run dev würde sonst das Free-Tier-Kontingent verbrauchen.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANGFUSE_BASE_URL=https://cloud.langfuse.com  # EU default, change for self-hosted
# LANGFUSE_PROJECT_URL=https://cloud.langfuse.com/<org-id>/<project-id>  # enables direct links in eval runner output

# Eval runner (PROJ-13) — workspace in which eval interview records are created
# Run once: SELECT id FROM workspaces LIMIT 1; in Supabase SQL editor
# EVAL_WORKSPACE_ID=<uuid of a workspace in your local DB>

# Eval runner tester model — LLM that simulates the persona (default: cheap flash-lite)
# TESTER_MODEL=google/gemini-3.1-flash-lite
